---
/**
 * A YouTube embed for docs pages.
 *
 *   <YouTube id="dQw4w9WgXcQ" title="What's New — July 2026" />
 *
 * Uses youtube-nocookie.com so an embed does not set tracking cookies for a
 * reader who never presses play, and lazy-loads so a page carrying a video
 * costs nothing until it scrolls into view.
 *
 * The 16:9 box is CSS rather than fixed dimensions — docs are read on
 * everything from a phone to an ultrawide, and a hardcoded height letterboxes
 * on both.
 */
interface Props {
  /** The 11-character YouTube video id, not the whole URL. */
  id: string;
  /** Accessible title. Screen readers announce this instead of "YouTube video player". */
  title: string;
  /** Optional caption rendered under the player. */
  caption?: string;
}

const { id, title, caption } = Astro.props;

if (!/^[A-Za-z0-9_-]{11}$/.test(id)) {
  throw new Error(
    `<YouTube> got id="${id}", which is not an 11-character video id. ` +
    `Pass the id, not the URL — https://youtu.be/XXXXXXXXXXX -> id="XXXXXXXXXXX".`
  );
}
---

<figure class="yt-figure">
  <div class="yt-frame">
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${id}?rel=0`}
      title={title}
      loading="lazy"
      frameborder="0"
      allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .yt-figure {
    margin: 0 0 1.5rem;
  }
  .yt-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    overflow: hidden;
    background: #000;
  }
  .yt-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
