---
/**
 * Custom Head override that:
 *   1. Renders Starlight's default <head> contents
 *   2. Replaces the og:image with a per-page generated image (via astro-og-canvas)
 *   3. Injects JSON-LD Article structured data for SEO rich results
 */
import Default from '@astrojs/starlight/components/Head.astro';

const { entry, lastUpdated } = Astro.locals.starlightRoute;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://docs.plaidcloud.com';

// Root page has an empty `entry.id`; astro-og-canvas emits the file as
// `open-graph/index.png`. Normalise so the meta URL points at the real file.
const slug = entry.id || 'index';

// Only certain pages get per-page OG images (see src/pages/open-graph/[...slug].ts).
// Reference workflow-step and expression function pages share a single default
// OG image to keep the build under the Workers Assets size cap.
function hasGeneratedOG(id: string): boolean {
	if (id.startsWith('reference/workflow-steps/') && id.split('/').length > 3) return false;
	if (id.startsWith('reference/expressions/') && id.split('/').length > 3) return false;
	return true;
}
const ogImageUrl = hasGeneratedOG(slug)
	? `${siteUrl}/open-graph/${slug}.png`
	: `${siteUrl}/open-graph/_default.png`;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? siteUrl).toString();
const lastUpdatedIso = lastUpdated
	? (lastUpdated instanceof Date ? lastUpdated.toISOString() : new Date(lastUpdated).toISOString())
	: undefined;

// astro-og-canvas generates 1200×630 PNGs — declare so social platforms render
// the preview at the right size instead of skipping the image.
const ogImageWidth = 1200;
const ogImageHeight = 630;
const ogImageAlt = `${entry.data.title} — PlaidCloud Documentation`;

const publisher = {
	'@type': 'Organization',
	name: 'PlaidCloud',
	url: 'https://plaidcloud.com',
	logo: {
		'@type': 'ImageObject',
		url: `${siteUrl}/favicon.ico`,
	},
};

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'TechArticle',
	headline: entry.data.title,
	description: entry.data.description ?? '',
	image: {
		'@type': 'ImageObject',
		url: ogImageUrl,
		width: ogImageWidth,
		height: ogImageHeight,
	},
	url: canonicalUrl,
	inLanguage: 'en-US',
	publisher,
	author: publisher,
	...(lastUpdatedIso && {
		dateModified: lastUpdatedIso,
		datePublished: lastUpdatedIso,
	}),
};

// Home page: emit a WebSite schema with a SearchAction so Google can show a
// sitelinks search box. The query parameter `q` is the standard Pagefind
// URL parameter used by Starlight's search UI.
const isHome = entry.id === '' || entry.id === 'index';
const websiteSchema = isHome
	? {
			'@context': 'https://schema.org',
			'@type': 'WebSite',
			name: 'PlaidCloud Documentation',
			alternateName: 'PlaidCloud Docs',
			url: `${siteUrl}/`,
			inLanguage: 'en-US',
			publisher,
			potentialAction: {
				'@type': 'SearchAction',
				target: {
					'@type': 'EntryPoint',
					urlTemplate: `${siteUrl}/?q={search_term_string}`,
				},
				'query-input': 'required name=search_term_string',
			},
		}
	: null;
---

<Default><slot /></Default>

<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content={String(ogImageWidth)} />
<meta property="og:image:height" content={String(ogImageHeight)} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />
<meta name="twitter:card" content="summary_large_image" />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
{websiteSchema && <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />}
