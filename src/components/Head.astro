---
/**
 * Custom Head override that:
 *   1. Renders Starlight's default <head> contents
 *   2. Replaces the og:image with a per-page generated image (see pages/open-graph/[...slug].ts)
 *   3. Injects JSON-LD structured data for SEO rich results
 *   4. On a locale fallback page (English content at /<locale>/x/), adds
 *      robots noindex and points canonical at the English page
 */
import Default from '@astrojs/starlight/components/Head.astro';
import { englishId, hasGeneratedOG } from '../lib/og-image';
import { buildCrumbs } from '../lib/breadcrumbs';
import { getLandingIds } from '../lib/landings';

const route = Astro.locals.starlightRoute;
const { entry, lastUpdated, locale, lang, isFallback } = route;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://docs.plaidcloud.com';

// Locale-independent page id (`de/guides/x` → `guides/x`; a fallback page's
// entry is already the English one).
const pageId = englishId(entry.id);

// Root page has an empty `entry.id`; the OG route emits the file as
// `open-graph/index.png`. Normalise so the meta URL points at the real file.
// OG cards are English-only: translated pages share their English page's card.
const slug = pageId || 'index';

const ogImageUrl = hasGeneratedOG(slug)
	? `${siteUrl}/open-graph/${slug}.png`
	: `${siteUrl}/open-graph/_default.png`;

// Starlight renders untranslated locale pages with the English content and
// a notice. Keep those duplicates out of search: noindex, and canonical (plus
// og:url, which Starlight sets to the same URL) on the English page. Starlight
// still emits the hreflang alternates.
const canonicalUrl = isFallback
	? new URL(pageId ? `/${pageId}/` : '/', Astro.site ?? siteUrl).toString()
	: new URL(Astro.url.pathname, Astro.site ?? siteUrl).toString();
if (isFallback) {
	for (const tag of route.head) {
		if (tag.tag === 'link' && tag.attrs?.rel === 'canonical') tag.attrs.href = canonicalUrl;
		if (tag.tag === 'meta' && tag.attrs?.property === 'og:url') tag.attrs.content = canonicalUrl;
	}
	route.head.push({ tag: 'meta', attrs: { name: 'robots', content: 'noindex' } });
}
const lastUpdatedIso = lastUpdated
	? (lastUpdated instanceof Date ? lastUpdated.toISOString() : new Date(lastUpdated).toISOString())
	: undefined;

// The OG route generates 1200×630 PNGs — declare so social platforms render
// the preview at the right size instead of skipping the image.
const ogImageWidth = 1200;
const ogImageHeight = 630;
const ogImageAlt = `${entry.data.title} — PlaidCloud Documentation`;

const publisher = {
	'@type': 'Organization',
	name: 'PlaidCloud',
	url: 'https://plaidcloud.com',
	logo: {
		'@type': 'ImageObject',
		url: `${siteUrl}/favicon.ico`,
	},
	sameAs: [
		'https://plaidcloud.com',
		'https://twitter.com/plaidcloud',
		'https://github.com/PlaidCloud',
	],
};

// First crumb in the breadcrumb trail is the page's top-level section
// (Get Started, Guides, Reference, etc.). Use it as `articleSection` so
// Google has a taxonomy hint for "what kind of article is this".
const slugParts = pageId.split('/').filter(Boolean);
const articleSection = slugParts.length > 0
	? slugParts[0].split('-').map((w) => w[0].toUpperCase() + w.slice(1)).join(' ')
	: undefined;

// Landing pages (any index page whose children exist in the collection)
// emit `WebPage`; standalone articles emit `TechArticle`.
const isHome = pageId === '' || pageId === 'index';
const landingIds = await getLandingIds();
const isLanding = isHome || landingIds.has(pageId);

const articleType = isLanding ? 'WebPage' : 'TechArticle';

const jsonLd: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@type': articleType,
	'@id': canonicalUrl,
	headline: entry.data.title,
	description: entry.data.description ?? '',
	image: {
		'@type': 'ImageObject',
		url: ogImageUrl,
		width: ogImageWidth,
		height: ogImageHeight,
	},
	url: canonicalUrl,
	mainEntityOfPage: canonicalUrl,
	inLanguage: isFallback || !locale ? 'en-US' : lang,
	publisher,
};
if (!isLanding) {
	jsonLd.author = publisher;
	if (articleSection) jsonLd.articleSection = articleSection;
}
if (lastUpdatedIso) {
	jsonLd.dateModified = lastUpdatedIso;
	if (!isLanding) {
		jsonLd.datePublished = lastUpdatedIso;
	}
}

// Home page: emit a WebSite schema. A SearchAction would require server-side
// query handling that Pagefind (browser-only) doesn't provide, so we omit it
// rather than ship a non-functional action target.
const websiteSchema = isHome && !locale
	? {
			'@context': 'https://schema.org',
			'@type': 'WebSite',
			name: 'PlaidCloud Documentation',
			alternateName: 'PlaidCloud Docs',
			url: `${siteUrl}/`,
			inLanguage: 'en-US',
			publisher,
		}
	: null;

// Build BreadcrumbList JSON-LD for deep pages — Home + each crumb + current page.
const crumbs = await buildCrumbs(entry.id, locale);
const homeUrl = locale ? `${siteUrl}/${locale}/` : `${siteUrl}/`;
const breadcrumbSchema = crumbs.length > 0
	? {
			'@context': 'https://schema.org',
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Home', item: homeUrl },
				...crumbs.map((c, i) => ({
					'@type': 'ListItem',
					position: i + 2,
					name: c.label,
					item: `${siteUrl}${c.href}`,
				})),
				// Last item is the current page; per Google guidance, omit `item`
				// because the user is already there.
				{ '@type': 'ListItem', position: crumbs.length + 2, name: entry.data.title },
			],
		}
	: null;
---

<Default><slot /></Default>

<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content={String(ogImageWidth)} />
<meta property="og:image:height" content={String(ogImageHeight)} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@plaidcloud" />

{/* LLM client auto-discovery — same llmstxt.org spec the site already serves */}
<link rel="alternate" type="text/plain" title="llms.txt — AI-friendly documentation index" href={`${siteUrl}/llms.txt`} />
<link rel="alternate" type="text/plain" title="llms-full.txt — complete documentation for AI ingestion" href={`${siteUrl}/llms-full.txt`} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
{websiteSchema && <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />}
{breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
